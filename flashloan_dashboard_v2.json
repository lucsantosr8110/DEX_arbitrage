{
  "id": null,
  "uid": "flashloan-v2",
  "title": "Flashloan Bot Dashboard v2",
  "tags": ["flashloan", "arbitrage", "monitoring"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "style": "dark",
  "panels": [
    {
      "type": "stat",
      "title": "Bot Status",
      "targets": [
        {
          "expr": "bot_status",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "timeseries",
      "title": "Arbitrage Opportunities",
      "targets": [
        { "expr": "arbitrage_executions_total", "refId": "A" }
      ],
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "timeseries",
      "title": "Profit (USD)",
      "targets": [
        { "expr": "profit_usd_total", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "gridPos": { "x": 0, "y": 4, "w": 6, "h": 4 }
    },
    {
      "type": "timeseries",
      "title": "Execution Latency (ms)",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(exec_latency_ms_bucket[1m])) by (le))", "refId": "A" }
      ],
      "gridPos": { "x": 6, "y": 4, "w": 6, "h": 4 }
    },
    {
      "type": "timeseries",
      "title": "Gas Spent (ETH)",
      "targets": [
        { "expr": "gas_spent_eth_total", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "eth" } },
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 }
    },
    {
      "type": "timeseries",
      "title": "Failures & Reverts",
      "targets": [
        { "expr": "failed_executions_total", "refId": "A" },
        { "expr": "reverted_executions_total", "refId": "B" }
      ],
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 }
    },
    {
      "type": "gauge",
      "title": "Risk Score",
      "targets": [{ "expr": "risk_score", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 10,
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 8 }
            ]
          }
        }
      },
      "gridPos": { "x": 0, "y": 12, "w": 6, "h": 4 }
    },
    {
      "type": "timeseries",
      "title": "Hit Rate (%)",
      "targets": [{ "expr": "hit_rate_percent", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percent" } },
      "gridPos": { "x": 6, "y": 12, "w": 6, "h": 4 }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "query": "label_values(bot_status, instance)",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "annotations": { "list": [] }
}
